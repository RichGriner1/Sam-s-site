---
import ProjectCard from './ProjectCard.astro'
import { getProyectos } from '$lib/proyectos'

const destacados = (await getProyectos()).filter((p) => p.data.featured).slice(0, 4)
---

<section class="container-site py-24 sm:py-32">
	<div class="flex items-end justify-between gap-6">
		<div>
			<p class="eyebrow fade-in">Trabajo seleccionado</p>
			<h2 class="fade-in fade-in-d1 mt-4 font-display text-5xl leading-none sm:text-7xl">
				Proyectos
			</h2>
		</div>
		<a
			href="/proyectos"
			class="fade-in hidden shrink-0 text-sm text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline sm:block"
		>
			Ver todos →
		</a>
	</div>

	<div class="mt-14 grid gap-x-8 gap-y-16 md:grid-cols-2">
		{
			destacados.map((p, i) => (
				<ProjectCard
					proyecto={p}
					aspect={i % 3 === 0 ? 'landscape' : 'portrait'}
					class:list={['fade-in', i % 2 === 1 && 'md:mt-24']}
				/>
			))
		}
	</div>

	<a
		href="/proyectos"
		class="mt-14 inline-flex h-12 items-center border border-foreground px-7 text-sm font-medium tracking-wide sm:hidden"
	>
		Ver todos los proyectos
	</a>
</section>
