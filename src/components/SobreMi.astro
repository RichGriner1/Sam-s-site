---
// Sobre mí en el inicio: versión corta y fácil de leer. "Leer bio completa" abre
// la biografía entera en un diálogo (BioModal).
import Media from './Media.astro'
import retrato from '../assets/sobre-mi.jpg'

const datos = [
	{ label: 'Base', value: 'República Dominicana / Madrid' },
	{ label: 'Formación', value: 'Artes Visuales y Danza (URJC) · Máster en Gestión Cultural (UCM)' },
	{ label: 'Proyectos en', value: 'República Dominicana, Haití, Colombia y España' }
]
const colaboradores = [
	'Matadero Madrid',
	'La Casa Encendida',
	'Teatro Pradillo',
	'Lenis Rodríguez',
	'Osikán',
	'Espacio Afro'
]
---

<section id="sobre-mi" class="scroll-mt-16 border-t border-border">
	<div class="container-site grid items-center gap-12 py-24 sm:py-32 md:grid-cols-2 md:gap-16">
		<Media
			src={retrato}
			alt="Samuel Ramírez sonriendo durante un ensayo, en blanco y negro"
			class="fade-in aspect-[4/5]"
		/>

		<div>
			<p class="eyebrow fade-in">Sobre mí</p>
			<h2
				class="fade-in fade-in-d1 mt-3 max-w-xl font-display text-4xl leading-[1.08] text-balance sm:text-5xl"
			>
				El cuerpo, la memoria y la comunidad como materia de creación.
			</h2>
			<div class="fade-in fade-in-d2 mt-6 max-w-xl space-y-4 text-muted-foreground">
				<p>
					Artista dominicano residente en Madrid. Trabaja entre la danza, la performance, las artes
					visuales y la dirección creativa para crear piezas, campañas y experiencias que ponen el
					cuerpo en el centro.
				</p>
				<p>
					Su trabajo ha pasado por Matadero Madrid, La Casa Encendida y Teatro Pradillo, y es
					director creativo y coreógrafo de la artista Lenis Rodríguez.
				</p>
			</div>

			<dl class="fade-in fade-in-d3 mt-8 divide-y divide-border border-y border-border">
				{
					datos.map((d) => (
						<div class="grid gap-1 py-3 sm:grid-cols-[8rem_1fr] sm:gap-4">
							<dt class="eyebrow pt-0.5">{d.label}</dt>
							<dd class="text-sm">{d.value}</dd>
						</div>
					))
				}
			</dl>

			<div class="fade-in fade-in-d4 mt-8 flex flex-wrap gap-3">
				<button
					type="button"
					data-modal-open="bio"
					class="inline-flex h-11 items-center rounded-lg border border-foreground/70 px-6 text-xs tracking-[0.2em] uppercase transition-colors hover:bg-foreground hover:text-background"
				>
					Leer bio completa
				</button>
				<button
					type="button"
					data-modal-open="contacto"
					class="inline-flex h-11 items-center rounded-lg bg-foreground px-6 text-xs tracking-[0.2em] text-background uppercase transition-opacity hover:opacity-85"
				>
					Trabajemos juntos
				</button>
			</div>
		</div>
	</div>

	<div class="container-site border-t border-border py-12">
		<p class="eyebrow">Ha trabajado con</p>
		<ul
			class="mt-5 flex flex-wrap gap-x-10 gap-y-3 font-display text-2xl text-muted-foreground sm:text-3xl"
		>
			{colaboradores.map((c) => <li>{c}</li>)}
		</ul>
	</div>
</section>
