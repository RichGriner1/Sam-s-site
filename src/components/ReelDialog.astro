---
// Reel en un diálogo: se abre con cualquier [data-modal-open="reel"].
import Modal from './Modal.astro'
import { site } from '../data/site'

const embed = `https://www.youtube-nocookie.com/embed/${site.reelYoutubeId}?autoplay=1&rel=0&playsinline=1&enablejsapi=1`
---

<Modal
	id="reel"
	label="Reel de Samuel Ramirez"
	class="aspect-video w-[min(92vw,calc(80svh*16/9))] overflow-hidden bg-background shadow-2xl sm:w-[min(80vw,calc(80svh*16/9))]"
>
	<iframe
		class="size-full"
		title="Reel de Samuel Ramirez"
		allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
		data-reel-iframe
		data-src={embed}></iframe>
</Modal>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('[data-modal="reel"]')!
	const iframe = dialog.querySelector<HTMLIFrameElement>('[data-reel-iframe]')!
	let clearTimer = 0

	dialog.addEventListener('modal:open', () => {
		clearTimeout(clearTimer)
		if (!iframe.src) iframe.src = iframe.dataset.src!
	})

	// Pausa de inmediato; el iframe se vacía cuando termina la animación de salida
	dialog.addEventListener('close', () => {
		iframe.contentWindow?.postMessage(
			JSON.stringify({ event: 'command', func: 'pauseVideo', args: [] }),
			'*'
		)
		clearTimer = window.setTimeout(() => iframe.removeAttribute('src'), 500)
	})
</script>
