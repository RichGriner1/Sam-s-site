---
// Diálogo compartido (reel, contacto). Se abre con cualquier [data-modal-open="<id>"]
// y se cierra con clic en cualquier parte fuera del panel, o con Esc.
// Un trigger puede llevar data-modal-tipo="<slug>" para preseleccionar algo dentro.
import { cn } from '$lib/utils'

interface Props {
	id: string
	label: string
	class?: string
}

const { id, label, class: className } = Astro.props
---

<dialog
	class="modal fixed inset-0 m-0 size-full max-h-none max-w-none bg-transparent p-0 text-foreground"
	aria-label={label}
	data-modal={id}
>
	<div class="grid size-full place-items-center p-4">
		<div class={cn('modal-panel rounded-lg', className)} data-modal-panel>
			<slot />
		</div>
	</div>

	<!-- Botón de cerrar que sigue al cursor (en touch queda fijo abajo) -->
	<span
		class="modal-cursor pointer-events-none fixed top-0 left-0 grid size-10 place-items-center rounded-full bg-foreground text-background"
		aria-hidden="true"
		data-modal-cursor
	>
		<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
			<path d="M1 1l12 12M13 1L1 13"></path>
		</svg>
	</span>
	<button
		type="button"
		class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-1/2 focus:-translate-x-1/2"
		data-modal-close
	>
		Cerrar
	</button>
</dialog>

<script>
	// Se ejecuta una sola vez aunque haya varios <Modal>
	const setup = (dialog: HTMLDialogElement) => {
		const panel = dialog.querySelector<HTMLElement>('[data-modal-panel]')!
		const cursor = dialog.querySelector<HTMLElement>('[data-modal-cursor]')!

		// Clic fuera del panel cierra. Se mide el inicio del clic para que
		// seleccionar texto dentro y soltar afuera no cierre el formulario.
		let downInside = false
		dialog.addEventListener('pointerdown', (e) => {
			downInside = panel.contains(e.target as Node)
		})
		dialog.addEventListener('click', (e) => {
			if (e.target instanceof Element && e.target.closest('[data-modal-close]')) dialog.close()
			else if (!downInside && !panel.contains(e.target as Node)) dialog.close()
		})

		dialog.addEventListener('pointermove', (e) => {
			if (e.pointerType !== 'mouse') return
			cursor.style.translate = `${e.clientX - 20}px ${e.clientY - 20}px`
			dialog.toggleAttribute('data-over-panel', panel.contains(e.target as Node))
			dialog.setAttribute('data-has-cursor', '')
		})
		panel.addEventListener('pointerenter', () => dialog.setAttribute('data-over-panel', ''))
		panel.addEventListener('pointerleave', () => dialog.removeAttribute('data-over-panel'))
	}

	// Videos dentro de un diálogo: se cargan al abrir (iframe[data-src]) y se
	// pausan y descargan al cerrar, para que nunca sigan sonando de fondo.
	const loadMedia = (dialog: HTMLDialogElement) => {
		clearTimeout(Number(dialog.dataset.unloadTimer))
		dialog.querySelectorAll<HTMLIFrameElement>('iframe[data-src]').forEach((f) => {
			if (!f.getAttribute('src')) f.src = f.dataset.src!
		})
	}
	const unloadMedia = (dialog: HTMLDialogElement) => {
		dialog.querySelectorAll<HTMLIFrameElement>('iframe[data-src]').forEach((f) =>
			f.contentWindow?.postMessage(
				JSON.stringify({ event: 'command', func: 'pauseVideo', args: [] }),
				'*'
			)
		)
		dialog.dataset.unloadTimer = String(
			window.setTimeout(
				() =>
					dialog
						.querySelectorAll<HTMLIFrameElement>('iframe[data-src]')
						.forEach((f) => f.removeAttribute('src')),
				500
			)
		)
	}

	// Al cerrar, el navegador devuelve el foco al botón que abrió el diálogo y puede
	// desplazar la página hasta él. Guardamos dónde estabas y volvemos ahí.
	let savedY: number | null = null
	const anyOpen = () => !!document.querySelector('dialog[data-modal][open]')
	const restoreScroll = () => {
		if (savedY === null || anyOpen()) return
		const y = savedY
		requestAnimationFrame(() => window.scrollTo({ top: y, behavior: 'instant' }))
		savedY = null
	}

	const open = (dialog: HTMLDialogElement, trigger?: HTMLElement) => {
		if (savedY === null) savedY = window.scrollY
		dialog.dispatchEvent(new CustomEvent('modal:open', { detail: { trigger } }))
		loadMedia(dialog)
		dialog.showModal()
		dialog.querySelector<HTMLElement>('[data-modal-panel]')?.scrollTo({ top: 0 })
	}

	document.querySelectorAll<HTMLDialogElement>('[data-modal]').forEach((d) => {
		setup(d)
		d.addEventListener('close', () => {
			unloadMedia(d)
			// en un cambio de diálogo (A → B) el siguiente se abre enseguida; esperamos
			setTimeout(restoreScroll, 260)
			window.scrollTo({ top: savedY ?? window.scrollY, behavior: 'instant' })
		})
	})

	document.addEventListener('click', (e) => {
		const trigger = (e.target as Element).closest<HTMLElement>('[data-modal-open]')
		if (!trigger) return
		const dialog = document.querySelector<HTMLDialogElement>(
			`[data-modal="${trigger.dataset.modalOpen}"]`
		)
		if (!dialog) return
		e.preventDefault()
		// Si el botón está dentro de otro diálogo, ese se cierra y se abre el nuevo
		const from = trigger.closest<HTMLDialogElement>('dialog[open]')
		if (from && from !== dialog) {
			from.close()
			setTimeout(() => open(dialog, trigger), 220)
		} else open(dialog, trigger)
	})

	// Un enlace como /#p-umbral abre ese diálogo al llegar (para compartir)
	const fromHash = location.hash.slice(1)
	if (fromHash) {
		const d = document.querySelector<HTMLDialogElement>(`[data-modal="${CSS.escape(fromHash)}"]`)
		if (d) open(d)
	}
</script>

<style is:global>
	html:has(.modal[open]) {
		overflow: hidden;
	}

	/* --- Diálogo: entra con resorte, sale con ease suave --- */
	.modal {
		cursor: none;
		transition:
			display 450ms allow-discrete,
			overlay 450ms allow-discrete;
	}
	.modal-panel {
		cursor: auto;
	}
	/* Barras de scroll finas y discretas dentro de los diálogos */
	.modal-panel,
	.modal-panel * {
		scrollbar-width: thin;
		scrollbar-color: oklch(100% 0 0 / 0.18) transparent;
	}
	@media (hover: none), (pointer: coarse) {
		.modal {
			cursor: auto;
		}
	}

	.modal::backdrop {
		background-color: oklch(0% 0 0 / 0);
		backdrop-filter: blur(0px);
		transition:
			background-color 450ms cubic-bezier(0.65, 0, 0.35, 1),
			backdrop-filter 450ms cubic-bezier(0.65, 0, 0.35, 1),
			display 450ms allow-discrete,
			overlay 450ms allow-discrete;
	}
	.modal[open]::backdrop {
		background-color: oklch(0% 0 0 / 0.45);
		backdrop-filter: blur(24px) saturate(1.2);
		transition-duration: var(--dur-in-out);
		transition-timing-function: var(--ease-out);
	}
	@starting-style {
		.modal[open]::backdrop {
			background-color: oklch(0% 0 0 / 0);
			backdrop-filter: blur(0px);
		}
	}

	/* Panel: cierre (estado base) */
	.modal-panel {
		opacity: 0;
		scale: 0.92;
		translate: 0 24px;
		transition:
			opacity 300ms var(--ease-in-out),
			scale var(--dur-exit) var(--ease-in-out),
			translate var(--dur-exit) var(--ease-in-out);
	}
	/* Panel: apertura con resorte */
	.modal[open] .modal-panel {
		opacity: 1;
		scale: 1;
		translate: 0 0;
		transition:
			opacity var(--dur-out) var(--ease-out),
			scale var(--dur-out-spring) var(--ease-out-spring),
			translate var(--dur-out-spring) var(--ease-out-spring);
	}
	@starting-style {
		.modal[open] .modal-panel {
			opacity: 0;
			scale: 0.92;
			translate: 0 24px;
		}
	}

	/* --- Círculo de cerrar --- */
	.modal-cursor {
		opacity: 0;
		scale: 0.4;
		transition:
			opacity 300ms var(--ease-out),
			scale var(--dur-out-spring) var(--ease-out-spring);
	}
	.modal[open][data-has-cursor]:not([data-over-panel]) .modal-cursor {
		opacity: 1;
		scale: 1;
	}
	@media (hover: none), (pointer: coarse) {
		.modal-cursor {
			top: auto;
			bottom: 2.5rem;
			left: 50%;
			translate: -50% 0 !important;
		}
		.modal[open] .modal-cursor {
			opacity: 1;
			scale: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.modal,
		.modal::backdrop,
		.modal-panel,
		.modal-cursor {
			transition-duration: 1ms !important;
		}
	}
</style>
