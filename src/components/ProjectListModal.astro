---
// "Ver todos": lista simple de todos los proyectos. Cada fila abre su diálogo.
import Modal from './Modal.astro'
import { getDisciplina } from '../data/site'
import { getProyectos } from '$lib/proyectos'

const proyectos = await getProyectos()
---

<Modal
	id="todos"
	label="Todos los proyectos"
	class="max-h-[88svh] w-[min(94vw,760px)] overflow-y-auto overscroll-contain glass-panel p-6 shadow-2xl sm:p-10"
>
	<p class="eyebrow">Portafolio</p>
	<h2 class="mt-3 font-display text-4xl leading-none sm:text-5xl">Todos los proyectos</h2>

	<ul class="mt-8 border-t border-border">
		{
			proyectos.map((p) => (
				<li class="border-b border-border">
					<button
						type="button"
						data-modal-open={`p-${p.id}`}
						class="group grid w-full grid-cols-[1fr_auto] items-baseline gap-x-6 gap-y-1 py-4 text-left sm:grid-cols-[4rem_1fr_auto]"
					>
						<span class="hidden text-sm text-muted-foreground tabular-nums sm:block">{p.data.year}</span>
						<span class="font-display text-2xl leading-tight transition-transform duration-500 ease-out group-hover:translate-x-1 sm:text-3xl">
							{p.data.title}
						</span>
						<span class="text-muted-foreground transition-colors group-hover:text-foreground" aria-hidden="true">
							→
						</span>
						<span class="col-span-2 text-xs text-muted-foreground sm:col-start-2">
							<span class="sm:hidden">{p.data.year} · </span>
							{p.data.disciplinas.map((d) => getDisciplina(d)?.name).join(' · ')}
						</span>
					</button>
				</li>
			))
		}
	</ul>
</Modal>
