---
// Galería curva: los proyectos corren sobre una pared cóncava, como el interior
// de un cilindro. El del centro queda plano y los de los lados se doblan hacia ti.
// Cada tarjeta se corta en tiras verticales; cada tira se coloca en la curva,
// así la tarjeta se dobla de verdad (no solo gira).
import { Image } from 'astro:assets'
import { getProyectos } from '$lib/proyectos'
import { getDisciplina } from '../data/site'

const STRIPS = 16

// En la pared solo van los destacados (máx. 5); "Ver todos" abre la lista completa
const todos = await getProyectos()
const destacados = todos.filter((p) => p.data.featured).slice(0, 5)
const proyectos = destacados.length >= 3 ? destacados : todos.slice(0, 5)
// Repetir la lista si hay pocos proyectos para que la pared nunca quede vacía
const reps = Math.max(1, Math.ceil(8 / Math.max(proyectos.length, 1)))
const cards = Array.from({ length: reps }, () => proyectos).flat()

const info = proyectos.map((p) => ({
	id: p.id,
	title: p.data.title,
	year: p.data.year,
	meta: [p.data.role, ...p.data.disciplinas.map((d) => getDisciplina(d)?.name)]
		.filter(Boolean)
		.join(' · ')
}))
---

<section id="proyectos" data-tone="light" class="cg-light relative scroll-mt-16 overflow-hidden bg-background pt-20 pb-24 text-foreground sm:pt-24 sm:pb-32" aria-labelledby="cg-title">
	<div class="container-site">
		<p class="eyebrow fade-in">Trabajo seleccionado</p>
		<div class="mt-3 flex items-baseline justify-between gap-6">
			<h2 id="cg-title" class="fade-in fade-in-d1 font-display text-5xl leading-none sm:text-7xl">
				Proyectos
			</h2>
			<a
				href="/proyectos"
				data-modal-open="todos"
				class="fade-in shrink-0 text-sm text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline"
			>
				Ver todos ({todos.length}) →
			</a>
		</div>
	</div>

	<!-- Recorte: las tarjetas que se estiran en los bordes no invaden el título -->
	<div class="cg-clip relative mt-6 overflow-hidden sm:mt-10">
	<div
		class="cg-stage relative w-full touch-pan-y select-none"
		data-cg
		data-count={proyectos.length}
		data-info={JSON.stringify(info)}
		tabindex="0"
		aria-roledescription="carrusel"
		aria-label="Proyectos — arrastra o usa las flechas"
	>
		{
			cards.map((p, k) => (
				<a
					href={`/proyectos/${p.id}`}
					data-modal-open={`p-${p.id}`}
					class="cg-card"
					data-cg-card
					data-index={k % proyectos.length}
					aria-label={p.data.title}
					tabindex={k < proyectos.length ? 0 : -1}
					aria-hidden={k < proyectos.length ? undefined : 'true'}
					draggable="false"
				>
					{Array.from({ length: STRIPS }, (_, i) => (
						// Imágenes "eager": con lazy, el navegador no detecta bien las tiras en 3D y
						// algunas nunca cargaban. Todas comparten la misma URL, así que se descargan una vez.
						<div class="cg-strip" data-cg-strip data-i={i} aria-hidden="true">
							{/* Capa 1: la imagen */}
							<div class="cg-face" data-cg-face>
								{p.data.cover ? (
									<Image
										src={p.data.cover}
										alt=""
										widths={[400, 700]}
										sizes="440px"
										width={p.data.cover.width}
										height={p.data.cover.height}
										loading="eager"
										fetchpriority="low"
										decoding="async"
										draggable="false"
										class="absolute inset-0 size-full object-cover"
									/>
								) : (
									<div class={`cg-tone cg-tone-${k % 6} absolute inset-0`} />
								)}
							</div>
							{/* Capa 3: solo el borde fino de la tarjeta activa (sin texto: el título va abajo) */}
							<div class="cg-face cg-face-top" data-cg-face />
						</div>
					))}
				</a>
			))
		}
	</div>
		<!-- Reflejo de agua: una copia simple de la pared, volteada bajo el "piso" y pasada por
		     un filtro de ondas. Las tiras copian la posición de las de arriba en cada cuadro. -->
		<div class="cg-reflect pointer-events-none absolute inset-x-0 overflow-hidden" aria-hidden="true" data-cg-reflect>
			<div class="cg-reflect-stage absolute inset-x-0" data-cg-reflect-stage>
				{
					cards.map((p, k) => (
						<div class="cg-card" data-cg-rcard>
							{Array.from({ length: STRIPS }, (_, i) => (
								<div class="cg-strip" data-cg-rstrip data-i={i}>
									<div class="cg-face" data-cg-rface>
										{p.data.cover ? (
											<Image
												src={p.data.cover}
												alt=""
												width={400}
												loading="eager"
												fetchpriority="low"
												decoding="async"
												draggable="false"
												class="absolute inset-0 size-full object-cover"
											/>
										) : (
											<div class={`cg-tone cg-tone-${k % 6} absolute inset-0`} />
										)}
									</div>
								</div>
							))}
						</div>
					))
				}
			</div>
		</div>
		<svg class="absolute size-0" aria-hidden="true">
			<filter id="cg-water" x="-5%" y="-10%" width="110%" height="120%">
				<feTurbulence type="fractalNoise" baseFrequency="0.004 0.06" numOctaves="2" seed="7" result="ondas">
					<animate attributeName="baseFrequency" dur="14s" values="0.004 0.06;0.005 0.075;0.004 0.06" repeatCount="indefinite" />
				</feTurbulence>
				<feDisplacementMap in="SourceGraphic" in2="ondas" scale="10" xChannelSelector="R" yChannelSelector="G" />
				<feGaussianBlur stdDeviation="0.8" />
			</filter>
		</svg>

		<!-- Fuera de la escena 3D: si estuvieran dentro, se "pelean" en profundidad con la
		     tarjeta del centro y aparece una línea clara. -->
		<div class="cg-floor pointer-events-none absolute inset-x-0 bottom-0 h-1/6" aria-hidden="true"></div>
	</div>

	<div class="container-site mt-8 grid items-end gap-6 sm:mt-10 sm:grid-cols-[1fr_auto]">
		<a
			href={`/proyectos/${info[0]?.id}`}
			data-modal-open={`p-${info[0]?.id}`}
			class="group block"
			data-cg-link
		>
			<p class="cg-info font-display text-3xl leading-tight sm:text-4xl" data-cg-title>
				{info[0]?.title}
			</p>
			<p class="cg-info mt-1 text-sm text-muted-foreground" data-cg-meta>
				{info[0]?.year} · {info[0]?.meta}
			</p>
		</a>
		<div class="flex items-center gap-4">
			<span class="text-sm text-muted-foreground tabular-nums" data-cg-count>
				01 / {String(proyectos.length).padStart(2, '0')}
			</span>
			<button
				type="button"
				class="cg-arrow grid size-12 place-items-center rounded-lg border border-border hover:border-foreground"
				aria-label="Proyecto anterior"
				data-cg-prev>←</button
			>
			<button
				type="button"
				class="cg-arrow grid size-12 place-items-center rounded-lg border border-border hover:border-foreground"
				aria-label="Proyecto siguiente"
				data-cg-next>→</button
			>
		</div>
	</div>
</section>

<script>
	type Info = { id: string; title: string; year: number; meta: string }

	const stage = document.querySelector<HTMLElement>('[data-cg]')
	if (stage) init(stage)

	function init(stage: HTMLElement) {
		const count = Number(stage.dataset.count)
		const info: Info[] = JSON.parse(stage.dataset.info!)
		const cards = [...stage.querySelectorAll<HTMLAnchorElement>('[data-cg-card]')]
		const strips = cards.map((c) => [...c.querySelectorAll<HTMLElement>('[data-cg-strip]')])
		const faces = cards.map((c) => [...c.querySelectorAll<HTMLElement>('[data-cg-face]')])
		const reflect = document.querySelector<HTMLElement>('[data-cg-reflect]')!
		const reflectStage = document.querySelector<HTMLElement>('[data-cg-reflect-stage]')!
		const rcards = [...reflectStage.querySelectorAll<HTMLElement>('[data-cg-rcard]')]
		const rstrips = rcards.map((c) => [...c.querySelectorAll<HTMLElement>('[data-cg-rstrip]')])
		const rfaces = [...reflectStage.querySelectorAll<HTMLElement>('[data-cg-rface]')]
		const N = strips[0]?.length ?? 1
		const link = document.querySelector<HTMLAnchorElement>('[data-cg-link]')!
		const titleEl = document.querySelector<HTMLElement>('[data-cg-title]')!
		const metaEl = document.querySelector<HTMLElement>('[data-cg-meta]')!
		const countEl = document.querySelector<HTMLElement>('[data-cg-count]')!
		const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches

		// --- Medidas (se recalculan al cambiar el tamaño) ---
		// La pared es un cilindro visto desde muy cerca de su borde frontal:
		// con la perspectiva apenas mayor que el radio, las tarjetas de los lados
		// pasan casi junto a la cámara y se estiran, como en un lente.
		const tune = { radius: 0.4, radiusMobile: 0.95, persp: 1.5, perspMobile: 1.2 }
		let w = 0
		let cardW = 0
		let cardH = 0
		let step = 0
		let total = 0
		let R = 0
		let P = 0
		let stripW = 0

		function layout() {
			w = stage.clientWidth
			const mobile = w < 768
			cardW = mobile ? w * 0.64 : Math.min(Math.max(w * 0.22, 260), 380)
			cardH = cardW * 1.3
			step = cardW * (mobile ? 1.1 : 1.14)
			total = step * cards.length
			R = Math.max(w * (mobile ? tune.radiusMobile : tune.radius), cardW * 1.3)
			P = R * (mobile ? tune.perspMobile : tune.persp)
			stage.style.perspective = `${P}px`
			const H = cardH * (mobile ? 1.45 : 1.6)
			stage.style.height = `${H}px`
			// El "piso" pasa por la base de la tarjeta del centro; el reflejo se voltea ahí
			const floorY = H / 2 + cardH * 0.38
			reflect.style.top = `${floorY}px`
			reflect.style.height = `${H - floorY}px`
			reflectStage.style.top = `${-floorY}px`
			reflectStage.style.height = `${H}px`
			reflectStage.style.transformOrigin = `50% ${floorY}px`
			reflectStage.style.perspective = `${P}px`
			stage.style.fontSize = `${cardW / 22}px`
			stripW = cardW / N
			for (const list of faces)
				list.forEach((f) => {
					const i = Number(f.closest<HTMLElement>('[data-cg-strip]')!.dataset.i)
					f.style.width = `${cardW}px`
					f.style.height = `${cardH}px`
					f.style.left = `${-i * stripW}px`
				})
			for (const f of rfaces) {
				const i = Number(f.closest<HTMLElement>('[data-cg-rstrip]')!.dataset.i)
				f.style.width = `${cardW}px`
				f.style.height = `${cardH}px`
				f.style.left = `${-i * stripW}px`
			}
			for (const list of [...strips, ...rstrips])
				list.forEach((s) => {
					s.style.width = `${stripW + 2.25}px` // solapa para que no se vean costuras
					s.style.height = `${cardH}px`
				})
		}

		// --- Movimiento ---
		let pos = 0 // desplazamiento en px a lo largo de la pared
		let vel = 0
		let target: number | null = null
		let dragging = false
		let hovering = false
		let lastInteraction = -Infinity
		const DRIFT = reduce ? 0 : 0.045 // px por ms
		// Curva --ease-out-spring (tokens.css) muestreada: se interpola entre puntos
		const SPRING_PTS = [0, 0.1364, 0.2635, 0.3827, 0.4942, 0.5978, 0.6929, 0.7786, 0.854, 0.9174, 0.967, 0.9998, 1.012, 1.0109, 1.0097, 1.0085, 1.0072, 1.0059, 1.0047, 1.0036, 1.0025, 1.0015, 1.0007, 0.9999, 0.9993, 0.9988, 0.9984, 0.9981, 0.9979, 0.9978, 0.9977, 0.9977, 0.9978, 0.9979, 0.9981, 0.9983, 0.9985, 0.9987, 0.9989, 0.9991, 0.9993, 0.9995, 0.9996, 0.9998, 0.9999, 1, 1.0001, 1.0002, 1.0003, 1.0003, 1.0003, 1.0004, 1.0004, 1.0004, 1.0004, 1.0003, 1.0003, 1.0003, 1.0002, 1.0002, 1]
		const easeOutSpring = (u: number) => {
			const x = u * (SPRING_PTS.length - 1)
			const i = Math.floor(x)
			return i >= SPRING_PTS.length - 1 ? 1 : SPRING_PTS[i] + (SPRING_PTS[i + 1] - SPRING_PTS[i]) * (x - i)
		}
		// Curva --ease-in-out-spring: para las flechas cuando la pared está quieta
		const IN_OUT_PTS = [0, 0.0034, 0.0138, 0.0315, 0.0568, 0.0899, 0.1307, 0.1791, 0.2346, 0.2963, 0.3631, 0.4336, 0.506, 0.5784, 0.6489, 0.7157, 0.7774, 0.8329, 0.8813, 0.9221, 0.9552, 0.9805, 0.9982, 1.0086, 1.012, 1.0105, 1.0089, 1.0072, 1.0055, 1.0039, 1.0025, 1.0012, 1.0002, 0.9993, 0.9986, 0.9982, 0.9979, 0.9977, 0.9977, 0.9978, 0.998, 0.9982, 0.9985, 0.9987, 0.999, 0.9993, 0.9995, 0.9997, 0.9999, 1.0001, 1.0002, 1.0003, 1.0003, 1.0004, 1.0004, 1.0004, 1.0003, 1.0003, 1.0003, 1.0002, 1]
		const sample = (pts: number[], u: number) => {
			const x = u * (pts.length - 1)
			const i = Math.floor(x)
			return i >= pts.length - 1 ? 1 : pts[i] + (pts[i + 1] - pts[i]) * (x - i)
		}
		type Curve = { ease: (u: number) => number; ms: number }
		const OUT_SPRING: Curve = { ease: easeOutSpring, ms: 1000 }
		const IN_OUT_SPRING: Curve = { ease: (u) => sample(IN_OUT_PTS, u), ms: 1500 }
		let nextCurve: Curve = OUT_SPRING
		let tween = { from: 0, to: NaN, start: 0, curve: OUT_SPRING }

		const wrap = (v: number) => ((((v + total / 2) % total) + total) % total) - total / 2

		// Cada tira se suaviza y apaga según qué tan cerca está del borde de la pantalla:
		// el centro queda nítido, y al estirarse en los lados se vuelve neblina.
		// Valores cuantizados: solo se escribe cuando cambian.
		const lastEdge = strips.map((l) => l.map(() => -1))

		function render() {
			let best = Infinity
			let active = 0
			const half = w / 2
			cards.forEach((card, k) => {
				const s = wrap(k * step - pos)
				if (Math.abs(s) < best) {
					best = Math.abs(s)
					active = Number(card.dataset.index)
				}
				card.toggleAttribute('data-active', Math.abs(s) < step * 0.25)
				// Tarjetas totalmente fuera de pantalla: ni se calculan
				const away = Math.abs(s) - cardW / 2 > R * (Math.PI / 2)
				if (away !== card.hasAttribute('data-away')) {
					card.toggleAttribute('data-away', away)
					card.style.visibility = away ? 'hidden' : ''
					rcards[k].style.visibility = away ? 'hidden' : ''
				}
				if (away) return
				strips[k].forEach((el, i) => {
					const sc = s - cardW / 2 + (i + 0.5) * stripW
					const t = sc / R
					const x = R * Math.sin(t)
					const z = R * (1 - Math.cos(t))
					const screenX = (x * P) / (P - z) // dónde cae en pantalla
					if (Math.abs(t) > Math.PI / 2 || z > P * 0.97 || Math.abs(screenX) > half * 1.25) {
						if (lastEdge[k][i] !== -2) {
							el.style.visibility = 'hidden'
							rstrips[k][i].style.visibility = 'hidden'
							lastEdge[k][i] = -2
						}
						return
					}
					if (lastEdge[k][i] !== 0) {
						el.style.visibility = ''
						rstrips[k][i].style.visibility = ''
						lastEdge[k][i] = 0
					}
					const tf = `translate3d(${x - stripW / 2}px, ${-cardH * 0.62}px, ${z}px) rotateY(${-t}rad)`
					el.style.transform = tf
					rstrips[k][i].style.transform = tf
				})
			})
			setActive(active)
		}

		let current = -1
		let swapTimer = 0
		function setActive(i: number) {
			if (i === current) return
			current = i
			const d = info[i]
			link.href = `/proyectos/${d.id}`
			link.dataset.modalOpen = `p-${d.id}`
			countEl.textContent = `${String(i + 1).padStart(2, '0')} / ${String(count).padStart(2, '0')}`
			// Cruce suave: el texto anterior sale hacia arriba y el nuevo entra con resorte
			clearTimeout(swapTimer)
			for (const el of [titleEl, metaEl]) {
				el.classList.remove('is-in')
				el.classList.add('is-out')
			}
			swapTimer = window.setTimeout(() => {
				titleEl.textContent = d.title
				metaEl.textContent = `${d.year} · ${d.meta}`
				for (const el of [titleEl, metaEl]) {
					el.classList.remove('is-out')
					void el.offsetWidth
					el.classList.add('is-in')
				}
			}, 170)
		}

		let last = performance.now()
		function tick(now: number) {
			const dt = Math.min(now - last, 50)
			last = now
			if (!dragging) {
				if (target !== null) {
					// Mismo movimiento que --ease-out-spring: llega en ~200ms y se asienta
					// con un rebote de ~1% durante el resto del segundo.
					if (tween.to !== target) {
						tween = { from: pos, to: target, start: now, curve: nextCurve }
						nextCurve = OUT_SPRING
					}
					const u = Math.min(1, (now - tween.start) / tween.curve.ms)
					pos = tween.from + (tween.to - tween.from) * tween.curve.ease(u)
					if (u >= 1) {
						pos = target
						target = null
						vel = 0
					}
				} else {
					pos += vel * dt
					vel *= Math.pow(0.994, dt) // inercia
					if (Math.abs(vel) < 0.01) vel = 0
					const idle = now - lastInteraction > 2500
					if (!hovering && idle && vel === 0) pos += DRIFT * dt
				}
			}
			render()
			requestAnimationFrame(tick)
		}

		// Un clic con el mouse no debe dar foco a la tarjeta: el navegador desplazaría
		// la página para mostrarla entera. (Con teclado, Tab sigue funcionando.)
		stage.addEventListener('mousedown', (e) => e.preventDefault())

		// --- Arrastre ---
		let startX = 0
		let startPos = 0
		let moved = 0
		let lastX = 0
		let lastT = 0
		stage.addEventListener('pointerdown', (e) => {
			dragging = true
			target = null
			vel = 0
			moved = 0
			startX = lastX = e.clientX
			startPos = pos
			lastT = performance.now()
		})
		stage.addEventListener('pointermove', (e) => {
			if (!dragging) return
			const now = performance.now()
			moved = Math.max(moved, Math.abs(e.clientX - startX))
			// Solo "agarra" el puntero cuando ya es un arrastre: así un clic simple
			// llega a la tarjeta y abre su diálogo.
			if (moved > 6 && !stage.hasPointerCapture(e.pointerId)) {
				try {
					stage.setPointerCapture(e.pointerId)
				} catch {}
			}
			pos = startPos - (e.clientX - startX)
			if (now > lastT) vel = -(e.clientX - lastX) / (now - lastT)
			lastX = e.clientX
			lastT = now
			lastInteraction = now
		})
		const endDrag = () => {
			if (!dragging) return
			dragging = false
			if (performance.now() - lastT > 80) vel = 0
			lastInteraction = performance.now()
			// Al soltar, el resorte lleva a la tarjeta más cercana en la dirección del gesto
			if (moved > 6) target = Math.round((pos + vel * 180) / step) * step
		}
		stage.addEventListener('pointerup', endDrag)
		stage.addEventListener('pointercancel', endDrag)
		// Un arrastre no debe abrir el proyecto
		stage.addEventListener(
			'click',
			(e) => {
				if (moved > 6) {
					e.preventDefault()
					e.stopPropagation()
				}
			},
			true
		)
		stage.addEventListener('pointerenter', (e) => {
			if (e.pointerType === 'mouse') hovering = true
		})
		stage.addEventListener('pointerleave', () => (hovering = false))

		// Scroll horizontal del trackpad (no secuestra el vertical)
		let wheelTimer = 0
		stage.addEventListener(
			'wheel',
			(e) => {
				const dx = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.shiftKey ? e.deltaY : 0
				if (!dx) return
				e.preventDefault()
				target = null
				vel = 0
				pos += dx
				lastInteraction = performance.now()
				// cuando el trackpad se detiene, se acomoda en la tarjeta más cercana
				clearTimeout(wheelTimer)
				wheelTimer = window.setTimeout(() => (target = Math.round(pos / step) * step), 140)
			},
			{ passive: false }
		)

		// --- Botones y teclado ---
		const goTo = (dir: number) => {
			const base = target ?? pos
			// Desde quieto: entra y sale suave (in-out). Si ya se mueve, sigue sin frenar.
			nextCurve = target === null ? IN_OUT_SPRING : OUT_SPRING
			target = Math.round(base / step) * step + dir * step
			lastInteraction = performance.now()
		}
		document.querySelector('[data-cg-prev]')!.addEventListener('click', () => goTo(-1))
		document.querySelector('[data-cg-next]')!.addEventListener('click', () => goTo(1))
		stage.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowRight') goTo(1)
			else if (e.key === 'ArrowLeft') goTo(-1)
			else return
			e.preventDefault()
		})
		// Al tabular a una tarjeta, se centra
		cards.forEach((card, k) =>
			card.addEventListener('focus', () => {
				const s = wrap(k * step - pos)
				target = pos + s
				lastInteraction = performance.now()
