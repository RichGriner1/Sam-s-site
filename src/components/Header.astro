---
import { site } from '../data/site'

const links = [
	{ href: '/proyectos', label: 'Proyectos' },
	{ href: '/#disciplinas', label: 'Disciplinas' },
	{ href: '/#sobre-mi', label: 'Sobre mí' },
	{ href: '/#contacto', label: 'Contacto' }
]
---

<header
	class="site-header fixed inset-x-0 top-0 z-50"
	data-header
>
	<div class="container-site flex h-16 items-center justify-between">
		<a href="/" class="text-sm font-semibold tracking-[0.18em] uppercase">{site.name}</a>

		<nav class="hidden items-center gap-8 md:flex" aria-label="Principal">
			{
				links.map((l) => (
					<a
						href={l.href}
						class="text-sm text-foreground/75 transition-colors hover:text-foreground"
					>
						{l.label}
					</a>
				))
			}
		</nav>

		<button
			type="button"
			class="-mr-2 p-2 text-sm tracking-[0.18em] uppercase md:hidden"
			aria-expanded="false"
			aria-controls="menu-movil"
			data-menu-toggle
		>
			Menú
		</button>
	</div>

	<nav
		id="menu-movil"
		class="hidden border-t border-border bg-background md:hidden"
		aria-label="Menú móvil"
		data-menu
	>
		<ul class="container-site flex flex-col py-4">
			{
				links.map((l) => (
					<li>
						<a href={l.href} class="block py-3 font-display text-3xl">
							{l.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-header]')!
	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!
	const menu = document.querySelector<HTMLElement>('[data-menu]')!

	const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8)
	onScroll()
	window.addEventListener('scroll', onScroll, { passive: true })

	const setOpen = (open: boolean) => {
		menu.classList.toggle('hidden', !open)
		toggle.setAttribute('aria-expanded', String(open))
		toggle.textContent = open ? 'Cerrar' : 'Menú'
		header.toggleAttribute('data-menu-open', open)
	}
	toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')))
	menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)))
</script>

<style>
	/* Arriba: transparente, deja ver el hero completo.
	   Al hacer scroll (o con el menú abierto): vidrio oscuro desenfocado. */
	.site-header {
		isolation: isolate;
		border-bottom-width: 0;
	}
	/* El vidrio vive en una capa propia para poder "rebotar" al entrar */
	.site-header::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background-color: oklch(8% 0 0 / 0.55);
		backdrop-filter: blur(20px) saturate(1.4);
		border-bottom: 1px solid oklch(100% 0 0 / 0.08);
		transform-origin: top;
		opacity: 0;
		scale: 1 0.6;
		/* salida: suave, sin rebote */
		transition:
			opacity 350ms cubic-bezier(0.65, 0, 0.35, 1),
			scale 450ms cubic-bezier(0.65, 0, 0.35, 1);
	}
	.site-header[data-scrolled]::before,
	.site-header[data-menu-open]::before {
		opacity: 1;
		scale: 1 1;
		/* entrada: resorte con ~12% de rebote */
		transition:
			opacity 300ms cubic-bezier(0.16, 1, 0.3, 1),
			scale 750ms
				linear(
					0, 0.0398, 0.1363, 0.2712, 0.4184, 0.5705, 0.7086, 0.8328, 0.9325, 1.0118, 1.067,
					1.1033, 1.1216, 1.1264, 1.1208, 1.1078, 1.0909, 1.0718, 1.0531, 1.0353, 1.0202, 1.0075,
					0.998, 0.991, 0.9867, 0.9845, 0.984, 0.9848, 0.9866, 0.9887, 0.9912, 0.9935, 0.9957,
					0.9976, 0.9992, 1.0004, 1.0012, 1.0017, 1.002, 1.002, 1
				);
	}
	@media (prefers-reduced-motion: reduce) {
		.site-header::before {
			transition-duration: 1ms !important;
		}
	}
</style>
